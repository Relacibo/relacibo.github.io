<script is:inline>
  // --- klassischer Cursor-Sternchen-Trail ---
  if (matchMedia("(pointer: fine)").matches) {
    const trailEmojis = ["✨", "⭐", "💫", "✦"];
    let lastTrail = 0;
    addEventListener("mousemove", (e) => {
      const now = performance.now();
      if (now - lastTrail < 60) return;
      lastTrail = now;
      const s = document.createElement("span");
      s.className = "trail";
      s.textContent = trailEmojis[Math.floor(Math.random() * trailEmojis.length)];
      s.style.left = e.clientX + "px";
      s.style.top = e.clientY + "px";
      s.style.fontSize = 10 + Math.random() * 12 + "px";
      document.body.appendChild(s);
      s.addEventListener("animationend", () => s.remove());
    });
  }

  // --- Besucherzähler (100% echt, wie oben geschrieben) ---
  (() => {
    const base = 1996;
    let visits = 1;
    try {
      visits = parseInt(localStorage.getItem("relacibo_hits") || "1", 10) + 1;
      localStorage.setItem("relacibo_hits", String(visits));
    } catch (e) {}
    const num = String(base + visits).padStart(6, "0");
    const el = document.getElementById("counter-digits");
    if (el) el.innerHTML = [...num].map((d) => `<span class="digit">${d}</span>`).join("");
  })();

  // --- Webring & Hinweis-Dialoge ---
  document.querySelectorAll("[data-alert]").forEach((el) =>
    el.addEventListener("click", (ev) => {
      ev.preventDefault();
      alert(el.dataset.alert);
    })
  );

  // --- Fake-Newsletter ---
  const nl = document.getElementById("newsletter");
  if (nl)
    nl.addEventListener("submit", (ev) => {
      ev.preventDefault();
      alert(
        "Vielen Dank für Ihre Anmeldung. Ihre Bestätigungs-E-Mail wird umgehend versendet."
      );
      nl.reset();
    });

  // --- MEGA MIDI MUSIK (WebAudio-Chiptune, „Ode an die Freude") ---
  (() => {
    const btn = document.getElementById("midi-btn");
    if (!btn) return;
    const N = {
      C5: 523.25, D5: 587.33, E5: 659.25, F5: 698.46, G5: 783.99,
    };
    // [Frequenz, Dauer in Sechzehnteln] — 0 = Pause
    const MELODY = [
      [N.E5,4],[N.E5,4],[N.F5,4],[N.G5,4],[N.G5,4],[N.F5,4],[N.E5,4],[N.D5,4],
      [N.C5,4],[N.C5,4],[N.D5,4],[N.E5,4],[N.E5,6],[N.D5,2],[N.D5,8],
      [N.E5,4],[N.E5,4],[N.F5,4],[N.G5,4],[N.G5,4],[N.F5,4],[N.E5,4],[N.D5,4],
      [N.C5,4],[N.C5,4],[N.D5,4],[N.E5,4],[N.D5,6],[N.C5,2],[N.C5,8],
    ];
    const STEP = 0.15;
    let ctx = null, timer = null, nextTime = 0, idx = 0, playing = false;

    function playNote(freq, when, dur) {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = "square";
      osc.frequency.value = freq;
      gain.gain.setValueAtTime(0.045, when);
      gain.gain.setValueAtTime(0.045, when + dur - 0.03);
      gain.gain.linearRampToValueAtTime(0, when + dur);
      osc.connect(gain).connect(ctx.destination);
      osc.start(when);
      osc.stop(when + dur);
    }

    function schedule() {
      while (nextTime < ctx.currentTime + 0.8) {
        const [freq, len] = MELODY[idx];
        const dur = len * STEP;
        if (freq > 0) playNote(freq, nextTime, Math.max(dur - 0.02, 0.05));
        nextTime += dur;
        idx = (idx + 1) % MELODY.length;
      }
    }

    btn.addEventListener("click", () => {
      if (!ctx) ctx = new (window.AudioContext || window.webkitAudioContext)();
      if (playing) {
        clearInterval(timer);
        playing = false;
        btn.textContent = "🎵 MEGA-MIDI-Musik: AUS";
      } else {
        if (ctx.state === "suspended") ctx.resume();
        nextTime = ctx.currentTime + 0.1;
        idx = 0;
        schedule();
        timer = setInterval(schedule, 250);
        playing = true;
        btn.textContent = "🎵 MEGA-MIDI-Musik: AN 💿";
      }
    });
  })();
</script>

<script is:inline>
  // --- 56k-Streaming: die Seite baut sich von oben nach unten auf ---
  (() => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      // Bewegung ausgeschaltet: GIFs sofort komplett zeigen
      document
        .querySelectorAll('.window-body img[src*="/gifs/"], .window-body .divider-sparkle')
        .forEach((el) => {
          el.style.clipPath = "inset(0 0 0% 0)";
        });
      return;
    }
    document.documentElement.classList.add("stream-loading");

    const DURATION = 10000;
    const bar = document.createElement("div");
    bar.className = "netload-bar";
    bar.innerHTML =
      '<span class="netload-label"></span>' +
      '<span class="netload-meter"><span class="netload-fill"></span></span>' +
      '<span class="netload-speed">28,8 kbps</span>';
    document.body.appendChild(bar);
    const label = bar.querySelector(".netload-label");
    const fill = bar.querySelector(".netload-fill");

    /* Der Text baut sich sehr schnell von oben nach unten auf (Rahmen wächst mit) */
    const chunks = document.querySelectorAll(".window-body > *");
    chunks.forEach((el, i) => {
      const when = 120 + 1100 * (i / chunks.length) + Math.random() * 40;
      setTimeout(() => el.classList.add("arrived"), when);
    });

    /* Die GIFs laden unregelmäßig nach (5–20 s).
       Gleiche GIFs (gleiche Quelle) laden synchron im gleichen Tempo. */
    const BANDS = 24;
    const schedules = new Map();
    function scheduleFor(key) {
      if (!schedules.has(key)) {
        const target = 5000 + Math.random() * 15000;
        const times = [];
        let prev = 0;
        for (let i = 1; i <= BANDS; i++) {
          let t = (i / BANDS) * target + (Math.random() - 0.5) * (target / BANDS) * 1.7;
          if (t <= prev) t = prev + 100;
          prev = t;
          times.push(Math.round(t));
        }
        schedules.set(key, times);
      }
      return schedules.get(key);
    }
    document
      .querySelectorAll('.window-body img[src*="/gifs/"], .window-body .divider-sparkle')
      .forEach((el) => {
        const key = el.src || "sparkle";
        el.style.clipPath = "inset(0 0 100% 0)";
        scheduleFor(key).forEach((t, i) => {
          const open = Math.round(((i + 1) / BANDS) * 100);
          setTimeout(() => {
            el.style.clipPath = "inset(0 0 " + (100 - open) + "% 0)";
          }, t);
        });
      });

    let elapsed = 0;
    const statusTimer = setInterval(() => {
      elapsed += 250;
      const pct = Math.min(100, Math.round((elapsed / DURATION) * 100));
      fill.style.width = pct + "%";
      label.textContent =
        "Lade Homepage von relacibo.github.io … " + pct + "%  (" + (elapsed / 1000).toFixed(1).replace(".", ",") + " s)";
      if (elapsed < DURATION + 250) return;
      clearInterval(statusTimer);
      fill.style.width = "100%";
      label.textContent =
        "Fertig — 1,4 MB in " + (DURATION / 1000).toFixed(1).replace(".", ",") + " Sekunden übertragen. Die restlichen Bilder folgen. (56k-Modem)";
      bar.querySelector(".netload-speed").textContent = "⚡";
      document.documentElement.classList.remove("stream-loading");
      setTimeout(() => {
        bar.style.opacity = "0";
      }, 2600);
    }, 250);
  })();
</script>

<script is:inline>
  // --- Einseiten-Webring: beide Richtungen laden diese Seite neu ---
  document.querySelectorAll(".webring a").forEach((a) => {
    a.addEventListener("click", (ev) => {
      ev.preventDefault();
      window.scrollTo(0, 0);
      location.reload();
    });
  });

  // --- Terminbuchung: fertige E-Mail via mailto + Fax-Backup-Gag ---
  (() => {
    const booking = document.getElementById("booking-form");
    if (!booking) return;
    const dateInput = document.getElementById("booking-date");
    const dateHint = document.getElementById("booking-hint");
    const earliest = new Date();
    earliest.setDate(earliest.getDate() + 1);
    if (dateInput) dateInput.min = earliest.toISOString().slice(0, 10);
    if (dateHint)
      dateHint.textContent =
        "Frühester verfügbarer Termin: " +
        earliest.toLocaleDateString("de-DE") +
        " — das Mikrofon bestellen wir dann gemeinsam am Tag 2.";
    const slotSelect = document.getElementById("booking-slot");
    if (slotSelect) slotSelect.disabled = !dateInput || !dateInput.value;
    if (dateInput)
      dateInput.addEventListener("input", () => {
        if (slotSelect) slotSelect.disabled = !dateInput.value;
      });

    /* Persönliche Zeitfenster: zufällig, aber pro Besucher konsistent (localStorage) */
    const POOL_START = 8 * 60;
    const POOL_END = 17 * 60;
    function fmtMin(min) {
      return (
        String(Math.floor(min / 60)).padStart(2, "0") +
        ":" +
        String(min % 60).padStart(2, "0")
      );
    }
    function generateSlots() {
      const starts = new Set();
      while (starts.size < 4) {
        const s =
          POOL_START +
          Math.floor(Math.random() * (POOL_END - POOL_START - 15));
        starts.add(s - (s % 5)); // auf 5-Minuten-Raster runden
      }
      return [...starts]
        .sort((a, b) => a - b)
        .map((s) => fmtMin(s) + "–" + fmtMin(s + 15) + " Uhr");
    }
    /* Persönliche Zeitfenster: pro Tag neu berechnet, am selben Tag konsistent */
    const today = new Date().toISOString().slice(0, 10);
    let slots = null;
    let stored = null;
    try {
      stored = JSON.parse(localStorage.getItem("relacibo_slots") || "null");
    } catch (e) {
      stored = null;
    }
    if (
      stored &&
      stored.tag === today &&
      Array.isArray(stored.slots) &&
      stored.slots.length >= 4
    ) {
      slots = stored.slots;
    } else {
      slots = generateSlots();
      try {
        localStorage.setItem(
          "relacibo_slots",
          JSON.stringify({ tag: today, slots })
        );
      } catch (e) {}
    }
    if (slotSelect) {
      slotSelect.innerHTML = "";
      slots.forEach((s) => {
        const opt = document.createElement("option");
        opt.textContent = s;
        slotSelect.appendChild(opt);
      });
      const fax = document.createElement("option");
      fax.textContent = "Nach Absprache (per Fax)";
      slotSelect.appendChild(fax);
    }

    booking.addEventListener("submit", (ev) => {
      ev.preventDefault();
      if (!booking.reportValidity()) return;
      const val = (id) => {
        const el = document.getElementById(id);
        return el && el.value ? el.value.trim() : "";
      };
      const date = val("booking-date");
      const dateDe = date ? new Date(date + "T12:00:00").toLocaleDateString("de-DE") : "—";
      const subject = "Terminbuchung — Relacibo KI-Beratung (63-Tage-Methode™)";
      const body =
        "Guten Tag,\n\n" +
        "hiermit buche ich einen Beratungstermin (63-Tage-Methode™).\n\n" +
        "Name: " + val("booking-name") + "\n" +
        "Wunschtermin: " + dateDe + "\n" +
        "Zeitfenster: " + (val("booking-slot") || "—") + "\n" +
        "Anliegen: " + (val("booking-topic") || "—") + "\n\n" +
        "Mit freundlichen Grüßen";
      const TO = encodeURIComponent(
        '"Relacibo\'s KI-Beratung" <reinhard_bronner@t-online.de>'
      );
      window.location.href =
        "mailto:" +
        TO +
        "?subject=" +
        encodeURIComponent(subject) +
        "&body=" +
        encodeURIComponent(body);
    });
    const faxBtn = document.getElementById("fax-btn");
    if (faxBtn)
      faxBtn.addEventListener("click", () => {
        alert(
          "Das Faxgerät ist momentan im Einsatz (Empfang Ihrer Wallet-Adresse). Bitte verwenden Sie den E-Mail-Knopf — oder versuchen Sie es in 2 Monaten erneut."
        );
      });
  })();
</script>

